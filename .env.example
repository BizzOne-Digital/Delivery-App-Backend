PORT=5000
NODE_ENV=development
MONGODB_URI=<PASTE_ROTATED_MONGODB_ATLAS_URI_HERE>
# Use Atlas *mongos* URI when on a sharded cluster (same app code)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=0
# Optional: secondaryPreferred when Atlas replica set has read replicas
# MONGODB_READ_PREFERENCE=secondaryPreferred
# Optional: extra cluster URIs (comma-separated) for advanced multi-cluster setups
# MONGODB_SHARD_URIS=
# Use 32+ random characters each in production (openssl rand -base64 48)
JWT_ACCESS_SECRET=<STRONG_RANDOM_SECRET>
JWT_REFRESH_SECRET=<STRONG_RANDOM_SECRET>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CLIENT_URL=http://localhost:8081
UPLOAD_BASE_URL=http://localhost:5000
SEED_PASSWORD=<DEVELOPMENT_PASSWORD>
CLAIM_WINDOW_HOURS_BEFORE=24
DRIVER_SCHEDULE_VISIBILITY_DAYS=7
GPS_STALE_THRESHOLD_MINUTES=5

# Email (GoDaddy) — pharmacy/driver credentials & password OTP
# Classic GoDaddy Workspace: SMTP_PROVIDER=godaddy
# Microsoft 365 on GoDaddy: SMTP_PROVIDER=microsoft (enable Authenticated SMTP in M365 admin)
SMTP_PROVIDER=godaddy
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
# M365 example:
# SMTP_PROVIDER=microsoft
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-app-password
SMTP_FROM=
SMTP_FROM_NAME=MLKS Delivery
